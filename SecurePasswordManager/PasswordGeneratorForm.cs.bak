using SecurePasswordManager.Security;
using SecurePasswordManager.Services;
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace SecurePasswordManager
{
    public partial class chkUppercase : Form
    {
        private readonly PasswordGenerator _generator;
        private readonly PasswordStrengthEvaluator _evaluator;
        private readonly ClipboardService _clipboard;
        public chkUppercase()
        {
            InitializeComponent();
            _generator = new PasswordGenerator();
            _evaluator = new PasswordStrengthEvaluator();
            _clipboard = new ClipboardService();
        }
        private void GeneratePassword()
        {
            try
            {
                int length =
                    (int)numLength.Value;

                string password =
                    _generator.Generate(
                        length,
                        Uppercase.Checked,
                        Lowercase.Checked,
                        Digits.Checked,
                        Symbols.Checked);

                txtGeneratedPassword.Text =
                    password;

                EvaluatePassword(password);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    ex.Message,
                    "خطأ",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);
            }
        }
        private void checkBox1_CheckedChanged(object sender, EventArgs e)
        {

        }
        private void EvaluatePassword(
    string password)
        {
            PasswordStrengthResult result =
                _evaluator.Evaluate(password);

            lblStrength.Text =
                $"القوة: {GetArabicStrength(result.Level)} ({result.Score}/100)";

            if (result.Suggestions.Count == 0)
            {
                lblSuggestions.Text =
                    "لا توجد ملاحظات. كلمة المرور جيدة.";
            }
            else
            {
                lblSuggestions.Text =
                    string.Join(
                        Environment.NewLine,
                        result.Suggestions.Select(
                            suggestion => "• " + suggestion));
            }
        }
        private static string GetArabicStrength(
    PasswordStrengthLevel level)
        {
            return level switch
            {
                PasswordStrengthLevel.Weak =>
                    "ضعيفة",

                PasswordStrengthLevel.Medium =>
                    "متوسطة",

                PasswordStrengthLevel.Strong =>
                    "قوية",

                PasswordStrengthLevel.VeryStrong =>
                    "قوية جدًا",

                _ => "غير معروف"
            };
        }

        private void btnGenerate_Click(
    object sender,
    EventArgs e)
        {
            GeneratePassword();
        }

        private void btnRegenerate_Click(
    object sender,
    EventArgs e)
        {
            GeneratePassword();
        }

        private void btnCopy_Click(
    object sender,
    EventArgs e)
        {
            string password =
                txtGeneratedPassword.Text;

            if (string.IsNullOrEmpty(password))
            {
                MessageBox.Show(
                    "لا توجد كلمة مرور لنسخها.",
                    "تنبيه",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information);

                return;
            }

            _clipboard.CopyText(password);

            MessageBox.Show(
                "تم نسخ كلمة المرور.",
                "تم",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information);
        }
        private void btnEvaluate_Click(
    object sender,
    EventArgs e)
        {
            string password =
                txtPasswordToEvaluate.Text;

            if (string.IsNullOrWhiteSpace(password))
            {
                MessageBox.Show(
                    "أدخل كلمة مرور أولًا لتقييم قوتها.",
                    "تنبيه",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information);

                txtPasswordToEvaluate.Focus();
                return;
            }

            EvaluatePassword(password);
        }
        private void btnTogglePassword_Click(
    object sender,
    EventArgs e)
        {
            txtPasswordToEvaluate.UseSystemPasswordChar =
                !txtPasswordToEvaluate.UseSystemPasswordChar;

            btnTogglePassword.Text =
                txtPasswordToEvaluate.UseSystemPasswordChar
                    ? "إظهار"
                    : "إخفاء";
        }
        private void label3_Click(object sender, EventArgs e)
        {

        }

        private void label3_Click_1(object sender, EventArgs e)
        {

        }

        private void textBox1_TextChanged(object sender, EventArgs e)
        {

        }

        private void chkUppercase_Load(object sender, EventArgs e)
        {

        }
    }
}